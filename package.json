{
  "name": "quickask",
  "version": "0.1.2",
  "description": "QuickAsk — a fast, local-first desktop AI assistant for Linux and Windows (Electron)",
  "homepage": "https://github.com/ragn-xt12114/quick-ask",
  "author": {
    "name": "ragn-xt12114",
    "email": "237755263+ragn-xt12114@users.noreply.github.com"
  },
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "node node_modules/electron/install.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --pass-with-no-tests",
    "dist:dir": "npm run build && npm run build:native && electron-builder --dir",
    "build:native": "node scripts/build-native.mjs",
    "dist:deb": "npm run build && npm run build:native && electron-builder --linux deb",
    "dist:win": "npm run build && npm run build:native && electron-builder --win"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@types/markdown-it": "14.2.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "7.24.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "com.quickask.app",
    "productName": "QuickAsk",
    "executableName": "quickask",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility",
      "desktop": {
        "entry": {
          "StartupWMClass": "quickask"
        }
      },
      "extraResources": [
        {
          "from": "native",
          "to": "native",
          "filter": [
            "quickask?x11"
          ]
        }
      ],
      "maintainer": "ragn-xt12114 <237755263+ragn-xt12114@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/256x256.png"
    },
    "extraResources": [
      {
        "from": "assets/tray-32.png",
        "to": "assets/tray-32.png"
      },
      {
        "from": "build/icons/32x32.png",
        "to": "build/icons/32x32.png"
      }
    ]
  },
  "keywords": [
    "electron",
    "ai",
    "desktop",
    "spotlight",
    "llm",
    "assistant",
    "sqlite",
    "react",
    "typescript",
    "linux",
    "windows"
  ]
}
